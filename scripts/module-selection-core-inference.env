# Aqli Core Inference Build
# Includes: Core, SPI, SDK (no runners, no training, no models)

BACKEND_TARGETS="cpu,metal"
FORMAT_TARGETS="gguf,litert,onnx,safetensor"
LLM_TARGETS="text,vision"
ARCHITECTURE_TARGETS="binding,native-java"
ARCHITECTURE_TARGET="binding,native-java"
BUILD_PROFILE="release"
RESOLVED_BACKEND_PROPERTY="cpu,metal"

# Core inference modules only - excludes runners, ml, models, training
MODULES=":core:aqli-error-code :core:aqli-ir :core:aqli-ir-schema :core:aqli-adapter :core:aqli-core :core:aqli-model-repository :core:aqli-model-runner :core:aqli-provider-core :core:aqli-provider-routing :core:aqli-runtime-config :core:aqli-tokenizer-core :core:aqli-tool-core :core:aqli-observability :core:aqli-multitenancy :core:plugin:aqli-plugin-core :core:plugin:aqli-plugin-kernel-core :spi:aqli-spi :spi:aqli-spi-inference :spi:aqli-spi-model :spi:aqli-spi-plugin :spi:aqli-spi-provider :spi:aqli-spi-runtime :sdk:aqli-sdk :sdk:aqli-sdk-core :sdk:aqli-sdk-api :sdk:aqli-sdk-local"

WARNINGS="Core inference only - excludes runners (need complete checkout)"
SCRIPT_SLUG="core-inference-only"
